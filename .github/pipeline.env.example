# Copy relevant lines to GitHub Actions → Secrets/Variables, or set locally.
# Full guide: .github/CI-PIPELINE.md

# --- Shared CI (already in build-release.yml) ---
# NODE_VERSION=20
# JAVA_VERSION=17
# ANDROID_NDK_VERSION=r26b          # CI (nttld/setup-ndk)
# NDK_HOME=%ANDROID_HOME%\ndk\26.1.10909125   # локально Windows

# --- Android (local Windows) ---
# ANDROID_HOME=%LOCALAPPDATA%\Android\Sdk
# ANDROID_SDK_ROOT=%ANDROID_HOME%
# NDK_HOME=%ANDROID_HOME%\ndk\26.1.10909125
# JAVA_HOME=C:\Program Files\Java\jdk-17

# --- Desktop (optional, Smart App Control on Windows) ---
# CARGO_TARGET_DIR=%LOCALAPPDATA%\custom-sda-cargo-target

# --- GitHub Secrets (optional prod signing; desktop updates use public Releases API) ---
# ANDROID_KEYSTORE_BASE64=
# ANDROID_KEYSTORE_PASSWORD=
# ANDROID_KEY_ALIAS=
# ANDROID_KEY_PASSWORD=
# APPLE_CERTIFICATE=
# APPLE_CERTIFICATE_PASSWORD=
# APPLE_PROVISIONING_PROFILE=
